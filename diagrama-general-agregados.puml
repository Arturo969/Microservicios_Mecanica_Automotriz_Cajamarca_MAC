@startuml diagrama-general-agregados

title Diagrama General de Agregados\nMecánica Automotriz Cajamarca (MAC) — Diseño Táctico DDD

skinparam backgroundColor #FEFEFE
skinparam packageStyle rectangle
skinparam packageBorderColor #3366CC
skinparam packageBorderThickness 2
skinparam classBorderColor #555555
skinparam classBackgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam arrowColor #444444
skinparam arrowThickness 1
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFFDD
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 40
skinparam padding 2
' ═══════════════════════════════════════════════════════════
'   CONTEXTO ACOTADO: RECEPCIÓN Y DIAGNÓSTICO (Core Domain)
' ═══════════════════════════════════════════════════════════
package "Contexto Acotado: Recepción y Diagnóstico (Core Domain)" as ctx_recepcion #E8F5E9 {

    package "Agregado Cliente" as agg_cliente #DCEDC8 {
        class "Cliente" as Cliente <<Aggregate Root>> {
            __Atributos__
            - id: ClienteId
            - dniRuc: String
            - nombreCompletoRazonSocial: String
            - [ContactoCliente] contacto
            - direccion: String
            __Métodos__
            + actualizarDatosContacto(nuevoContacto)
        }
        class "ContactoCliente" as ContactoCliente <<Value Object>> {
            - telefono: String
            - correo: String
        }
        Cliente *-right- "1" ContactoCliente
    }

    package "Agregado Vehiculo" as agg_vehiculo #DCEDC8 {
        class "Vehiculo" as Vehiculo <<Aggregate Root>> {
            __Atributos__
            - id: VehiculoId
            - [Placa] placa
            - vin: String
            - marca: String
            - modelo: String
            - [Kilometraje] kilometrajeActual
            - [ClienteId] clienteId
            __Métodos__
            + actualizarKilometraje(nuevoKm)
        }
        class "Placa" as Placa <<Value Object>> {
            - valor: String
        }
        class "Kilometraje" as Kilometraje <<Value Object>> {
            - valor: int
            + esMenorQue(otro): boolean
        }
        Vehiculo *-right- "1" Placa
        Vehiculo *-right- "1" Kilometraje
    }

    package "Agregado RecepcionVehicular" as agg_recepcion #DCEDC8 {
        class "RecepcionVehicular" as RecepcionVehicular <<Aggregate Root>> {
            __Atributos__
            - id: RecepcionId
            - [VehiculoId] vehiculoId
            - [ClienteId] clienteId
            - fechaIngreso: LocalDateTime
            - estado: EstadoRecepcion
            __Métodos__
            + iniciarInspeccion()
            + completarRecepcion()
        }
        class "InspeccionFisica" as InspeccionFisica <<Entity>> {
            - id: InspeccionFisicaId
            - fechaRegistro: LocalDateTime
            - danosCarroceria: List<String>
            - nivelCombustible: boolean
            - pertenenciasDejadas: List<String>
            - firmaClienteUrl: String
            + registrarObservacion(detalle)
            + asociarFirmaCliente(firmaUrl)
        }
        class "DiagnosticoOBD2" as DiagnosticoOBD2 <<Entity>> {
            - id: DiagnosticoId
            - fechaEscaneo: LocalDateTime
            - [CodigoFalla] codigosCapturados
            - notasTecnico: String
            + agregarCodigoFalla(codigo)
            + tieneFallasCriticas(): boolean
        }
        class "CodigoFalla" as CodigoFalla <<Value Object>> {
            - codigo: String
            - descripcion: String
        }
        RecepcionVehicular *-down- "0..1" InspeccionFisica
        RecepcionVehicular *-down- "0..1" DiagnosticoOBD2
        DiagnosticoOBD2 *-- "0..*" CodigoFalla
    }

    package "Agregado Cotizacion" as agg_cotizacion #DCEDC8 {
        class "Cotizacion" as Cotizacion <<Aggregate Root>> {
            __Atributos__
            - id: CotizacionId
            - [VehiculoId] vehiculoId
            - estado: EstadoCotizacion
            - [Monto] totalEstimado
            - diasInactividadEstimados: int
            - fechaCreacion: LocalDateTime
            __Métodos__
            + agregarItem(item)
            + aprobar(autorizacion)
        }
        class "ItemCotizacion" as ItemCotizacion <<Value Object>> {
            - descripcion: String
            - precioUnitario: Monto
            - cantidad: int
        }
        class "AutorizacionCliente" as AutorizacionCliente <<Value Object>> {
            - metodoAutorizacion: String
            - fechaHora: LocalDateTime
            - evidenciaUrl: String
        }
        Cotizacion *-- "1..*" ItemCotizacion
        Cotizacion ..> "0..1" AutorizacionCliente : "recibe al aprobar"
    }
}

' ═══════════════════════════════════════════════════════════
'   CONTEXTO ACOTADO: OPERACIONES DE TALLER (Core Domain)
' ═══════════════════════════════════════════════════════════
package "Contexto Acotado: Operaciones de Taller (Core Domain)" as ctx_taller #E3F2FD {

    package "Agregado OrdenTrabajo" as agg_orden #BBDEFB {
        class "OrdenTrabajo" as OrdenTrabajo <<Aggregate Root>> {
            __Atributos__
            - id: OrdenTrabajoId
            - [CotizacionId] cotizacionId
            - [VehiculoId] vehiculoId
            - [TecnicoId] tecnicoAsignadoId
            - estado: EstadoOrdenTrabajo
            - fechaInicio: LocalDateTime
            - fechaFinEstimada: LocalDateTime
            __Métodos__
            + asignarBahia(asignacion)
            + bloquearPorFaltaRepuesto(motivo)
            + completarTarea(tareaId)
            + marcarComoListaParaCalidad()
            + cerrarOrden()
        }
        class "OrdenBahia" as OrdenBahia <<Entity>> {
            - id: OrdenBahiaId
            - [BahiaTrabajoId] bahiaId
            - fechaIngreso: LocalDateTime
            - fechaSalida: LocalDateTime
            - estadoAsignacion: String
            + finalizarAsignacion()
        }
        class "TareaReparacion" as TareaReparacion <<Entity>> {
            - id: TareaReparacionId
            - descripcion: String
            - completada: boolean
            + adjuntarEvidencia(foto)
            + registrarConsumoRepuesto(uso)
        }
        class "FotoEvidencia" as FotoEvidencia <<Value Object>> {
            - urlFoto: String
            - fechaCaptura: LocalDateTime
        }
        class "RegistroUsoRepuesto" as RegistroUsoRepuesto <<Value Object>> {
            - [RepuestoId] repuestoId
            - cantidadUtilizada: int
        }
        OrdenTrabajo *-- "1..*" TareaReparacion
        OrdenTrabajo *-- "0..*" OrdenBahia
        TareaReparacion *-- "0..*" FotoEvidencia
        TareaReparacion *-- "0..*" RegistroUsoRepuesto
    }

    package "Agregado BahiaTrabajo" as agg_bahia #BBDEFB {
        class "BahiaTrabajo" as BahiaTrabajo <<Aggregate Root>> {
            __Atributos__
            - id: BahiaTrabajoId
            - codigo: String
            - tipo: TipoBahia
            - estado: EstadoBahia
            __Métodos__
            + ocuparConOrden(ordenId)
            + liberar()
            + ponerEnMantenimiento()
        }
    }
}

' ═══════════════════════════════════════════════════════════
'   CONTEXTO ACOTADO: CONTROL DE CALIDAD Y ENTREGA (Core)
' ═══════════════════════════════════════════════════════════
package "Contexto Acotado: Control de Calidad y Entrega (Core Domain)" as ctx_calidad #FFF3E0 {

    package "Agregado PruebaCalidad" as agg_prueba #FFE0B2 {
        class "PruebaCalidad" as PruebaCalidad <<Aggregate Root>> {
            __Atributos__
            - id: PruebaCalidadId
            - [OrdenTrabajoId] ordenTrabajoId
            - [SupervisorCalidadId] supervisorId
            - apruebaPruebaEstatica: boolean
            - apruebaPruebaRuta: boolean
            - estado: EstadoPruebaCalidad
            - observaciones: String
            __Métodos__
            + registrarResultadoEstatico(exitoso, detalles)
            + aprobarControlCalidad()
            + rechazarYEnviarARetrabajo(motivo)
        }
    }

    package "Agregado InformeEntrega" as agg_informe #FFE0B2 {
        class "InformeEntrega" as InformeEntrega <<Aggregate Root>> {
            __Atributos__
            - id: InformeEntregaId
            - [OrdenTrabajoId] ordenTrabajoId
            - fechaEntrega: LocalDateTime
            - [CondicionGarantia] garantiaOtorgada
            - vehiculoLavado: boolean
            __Métodos__
            + programarProximoMantenimiento(km, fecha)
        }
        class "CondicionGarantia" as CondicionGarantia <<Value Object>> {
            - duracionMeses: int
            - kilometrosCobertura: int
            - fechaInicio: LocalDateTime
        }
        class "RegistroMantenimientoSugerido" as RegistroMant <<Value Object>> {
            - kilometrajeSugerido: int
            - fechaEstimada: LocalDateTime
        }
        InformeEntrega *-- "1" CondicionGarantia
        InformeEntrega *-- "0..1" RegistroMant
    }
}

' ═══════════════════════════════════════════════════════════
'   CONTEXTO ACOTADO: INVENTARIO Y ALMACÉN (Supporting)
' ═══════════════════════════════════════════════════════════
package "Contexto Acotado: Inventario y Almacén (Supporting)" as ctx_inventario #F3E5F5 {

    package "Agregado Repuesto" as agg_repuesto #E1BEE7 {
        class "Repuesto" as Repuesto <<Aggregate Root>> {
            __Atributos__
            - id: RepuestoId
            - codigoSku: String
            - nombre: String
            - stockFisicoReal: int
            - stockReservado: int
            - [UmbralReposicion] umbral
            - [Monto] precioUnitario
            __Métodos__
            + reservarStock(cantidad)
            + despacharStock(cantidad)
            + evaluarUmbralReposicion(): boolean
        }
        class "UmbralReposicion" as UmbralReposicion <<Value Object>> {
            - cantidadMinima: int
        }
        Repuesto *-- "1" UmbralReposicion
    }

    package "Agregado ReservaRepuesto" as agg_reserva #E1BEE7 {
        class "ReservaRepuesto" as ReservaRepuesto <<Aggregate Root>> {
            __Atributos__
            - id: ReservaId
            - [CotizacionId] cotizacionId
            - [RepuestoId] repuestoId
            - cantidad: int
            - estado: EstadoReserva
            - fechaExpiracion: LocalDateTime
            __Métodos__
            + marcarComoConsumida()
            + cancelarReserva()
        }
    }
}

' ═══════════════════════════════════════════════════════════
'   CONTEXTO ACOTADO: AGENDAMIENTO (Supporting)
' ═══════════════════════════════════════════════════════════
package "Contexto Acotado: Agendamiento (Supporting)" as ctx_agenda #FFFDE7 {

    package "Agregado Cita" as agg_cita #FFF9C4 {
        class "Cita" as Cita <<Aggregate Root>> {
            __Atributos__
            - id: CitaId
            - [ClienteId] clienteId
            - [VehiculoId] vehiculoId
            - fechaProgramada: LocalDateTime
            - [SlotHorario] bloqueHorario
            - estado: EstadoCita
            __Métodos__
            + confirmarCita()
            + marcarComoAtendida()
            + cancelar()
            + reprogramar(nuevaFecha, nuevoBloque)
        }
        class "SlotHorario" as SlotHorario <<Value Object>> {
            - horaInicio: LocalTime
            - horaFin: LocalTime
        }
        Cita *-- "1" SlotHorario
    }
}

' ═══════════════════════════════════════════════════════════
'   CONTEXTO ACOTADO: GESTIÓN DE PERSONAL (Supporting)
' ═══════════════════════════════════════════════════════════
package "Contexto Acotado: Gestión de Personal (Supporting)" as ctx_personal #E0F7FA {

    package "Agregado Tecnico" as agg_tecnico #B2EBF2 {
        class "Tecnico" as Tecnico <<Aggregate Root>> {
            __Atributos__
            - id: TecnicoId
            - dni: String
            - nombreCompleto: String
            - especialidades: List<Especialidad>
            - estado: EstadoDisponibilidad
            - [TurnoHorario] turnoLaboral
            __Métodos__
            + asignarAOrden()
            + liberarTecnico()
        }
        class "TurnoHorario" as TurnoHorario <<Value Object>> {
            - horaInicio: LocalTime
            - horaFin: LocalTime
            + estaEnHorario(momento): boolean
        }
        Tecnico *-- "1" TurnoHorario
    }
}

' ═══════════════════════════════════════════════════════════
'   CONTEXTO ACOTADO: FACTURACIÓN Y FINANZAS (Generic)
' ═══════════════════════════════════════════════════════════
package "Contexto Acotado: Facturación y Finanzas (Generic)" as ctx_facturacion #FCE4EC {

    package "Agregado ComprobantePago" as agg_comprobante #F8BBD0 {
        class "ComprobantePago" as ComprobantePago <<Aggregate Root>> {
            __Atributos__
            - id: ComprobanteId
            - [InformeEntregaId] informeEntregaId
            - tipo: TipoComprobante
            - serieNumero: String
            - [Monto] montoSubtotal
            - [Monto] montoIgv
            - [Monto] montoTotal
            - estado: EstadoFactura
            - xmlFirmadoUrl: String
            __Métodos__
            + generarXMLSunat()
            + anularComprobante(motivo)
        }
    }
}

' ═══════════════════════════════════════════════════════════════════════
'   OPTIMIZACIÓN DE ESPACIO (GRID LAYOUT)
' ═══════════════════════════════════════════════════════════════════════
ctx_recepcion -[hidden]right-> ctx_taller
ctx_taller -[hidden]right-> ctx_calidad

ctx_inventario -[hidden]right-> ctx_agenda
ctx_agenda -[hidden]right-> ctx_facturacion
ctx_facturacion -[hidden]right-> ctx_personal

ctx_recepcion -[hidden]down-> ctx_inventario
ctx_taller -[hidden]down-> ctx_agenda
ctx_calidad -[hidden]down-> ctx_facturacion

' ═══════════════════════════════════════════════════════════════════════
'   RELACIONES INTER-AGREGADO — Notación Patita de Gallo (Crow's Foot)
'   Referencia por ID (línea punteada = consistencia eventual / débil)
'
'   Símbolos:  ||  = exactamente uno (obligatorio)
'              |o  = cero o uno (opcional)
'              }|  = uno o muchos
'              }o  = cero o muchos
' ═══════════════════════════════════════════════════════════════════════

' ── RECEPCIÓN Y DIAGNÓSTICO ──────────────────────────────

' Un Cliente posee muchos Vehículos; cada Vehículo pertenece a exactamente 1 Cliente
Cliente "1" ||..o{ "N" Vehiculo : "[clienteId]"

' Un Vehículo tiene muchas Recepciones; cada Recepción es de exactamente 1 Vehículo
Vehiculo "1" ||..o{ "N" RecepcionVehicular : "[vehiculoId]"

' Un Cliente tiene muchas Recepciones; cada Recepción es de exactamente 1 Cliente
Cliente "1" ||..o{ "N" RecepcionVehicular : "[clienteId]"

' Un Vehículo tiene muchas Cotizaciones; cada Cotización es de exactamente 1 Vehículo
Vehiculo "1" ||..o{ "N" Cotizacion : "[vehiculoId]"

' ── OPERACIONES DE TALLER ────────────────────────────────

' Una Cotización aprobada genera 0 o 1 OrdenTrabajo; cada OT nace de exactamente 1 Cotización
Cotizacion "1" ||..o| "0..1" OrdenTrabajo : "[cotizacionId]"

' Un Vehículo tiene muchas OTs a lo largo del tiempo; cada OT es de 1 Vehículo
Vehiculo "1" ||..o{ "N" OrdenTrabajo : "[vehiculoId]"

' Un Técnico atiende muchas OTs (secuencialmente); la OT puede no tener técnico asignado aún
Tecnico "0..1" |o..o{ "N" OrdenTrabajo : "[tecnicoAsignadoId]"

' Una Bahía aloja muchas OTs a lo largo del tiempo, y una OT pasa por muchas bahías (N:M).
' Resuelto internamente en el código por la entidad intermedia OrdenBahia.
BahiaTrabajo "0..N" }o..o{ "0..N" OrdenTrabajo : "Historial [bahiaId]"

' ── CONTROL DE CALIDAD Y ENTREGA ─────────────────────────

' Una OT tiene 0 o 1 PruebaCalidad; cada PruebaCalidad evalúa exactamente 1 OT
OrdenTrabajo "1" ||..o| "0..1" PruebaCalidad : "[ordenTrabajoId]"

' Una OT tiene 0 o 1 InformeEntrega; cada InformeEntrega cierra exactamente 1 OT
OrdenTrabajo "1" ||..o| "0..1" InformeEntrega : "[ordenTrabajoId]"

' ── INVENTARIO Y ALMACÉN ─────────────────────────────────

' Una Cotización genera muchas ReservaRepuesto; cada Reserva pertenece a 1 Cotización
Cotizacion "1" ||..o{ "N" ReservaRepuesto : "[cotizacionId]"

' Un Repuesto tiene muchas Reservas; cada Reserva aparta de 1 Repuesto
Repuesto "1" ||..o{ "N" ReservaRepuesto : "[repuestoId]"

' ── AGENDAMIENTO ─────────────────────────────────────────

' Un Cliente agenda muchas Citas; cada Cita es de exactamente 1 Cliente
Cliente "1" ||..o{ "N" Cita : "[clienteId]"

' Un Vehículo tiene muchas Citas; cada Cita es para exactamente 1 Vehículo
Vehiculo "1" ||..o{ "N" Cita : "[vehiculoId]"

' ── FACTURACIÓN Y FINANZAS ───────────────────────────────

' Un InformeEntrega genera 0 o 1 ComprobantePago; cada Comprobante factura 1 Informe
InformeEntrega "1" ||..o| "0..1" ComprobantePago : "[informeEntregaId]"


' ═══════════════════════════════════════════════════════════
'  LEYENDA
' ═══════════════════════════════════════════════════════════

legend bottom left
  |= Símbolo |= Significado |
  | <U+25C6>───── (sólida) | Composición interna del Agregado (Transacción Atómica, carga junta) |
  | ··<U+257C><U+257C>·· (doble barra punteada) | Exactamente uno — lado obligatorio (1) referenciado por ID |
  | ··o<U+257C>·· (círculo+barra punt.) | Cero o uno — lado opcional (0..1) referenciado por ID |
  | ··<U+257C><{ (patita de gallo punt.) | Uno o muchos — lado múltiple (1..N) referenciado por ID |
  | ··o{ (patita+círculo punt.) | Cero o muchos — lado múltiple (0..N) referenciado por ID |
  | Línea punteada (····>) | Referencia débil entre raíces de agregado mediante ID |
  | <<Aggregate Root>> | Raíz del agregado: única entidad con acceso global |
  | <<Entity>> | Entidad interna con identidad local |
  | <<Value Object>> | Objeto inmutable, definido por su valor |
  | [AtributoId] | Campo usado como foreign key lógica (ID referencial) |
end legend

note as N1
  **Reglas Transaccionales DDD (basado en el diagrama):**
  • Todo lo que está conectado por una línea sólida de composición (<U+25C6>─) 
    pertenece al **mismo agregado** y debe guardarse en una **única transacción atómica**
    (ej. RecepcionVehicular guarda InspeccionFisica y DiagnosticoOBD2 juntos).
  • Todo lo que está conectado por líneas punteadas (ej. Vehiculo ··> Cliente) 
    representa a **diferentes agregados** que interactúan. 
    Se guardan en transacciones separadas, referenciándose únicamente por **ID**.
  • Estas reglas previenen el acoplamiento duro y bloqueos en base de datos.
end note

@enduml
